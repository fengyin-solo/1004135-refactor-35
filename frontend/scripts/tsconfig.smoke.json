{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmitOnError": false,
    "outDir": "/tmp/smoke-build",
    "baseUrl": "..",
    "paths": { "@/*": ["src/*"] },
    "lib": ["ES2020", "DOM"]
  },
  "include": ["smoke-flight.ts", "../src/domain/**/*.ts", "../src/api/**/*.ts", "../src/data/**/*.ts"]
}
